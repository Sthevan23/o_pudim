DirectoryIndex index.html index.php
Options -Indexes

<Files "opudim_reservas.json">
  Require all denied
</Files>
<Files "config.local.php">
  Require all denied
</Files>
<FilesMatch "^(config\.local\.php|opudim_reservas\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^$ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
