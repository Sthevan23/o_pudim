generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MASTER
  ADMIN
  EMPLOYEE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resetTokens  PasswordResetToken[]
  auditLogs    AuditLog[]

  @@index([companyId])
  @@index([role])
}

model Company {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  ownerName   String
  email       String
  phone       String
  logoUrl     String?
  faviconUrl  String?
  status      CompanyStatus @default(ACTIVE)
  plan        String        @default("free")
  planExpiresAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users          User[]
  settings       CompanySettings?
  siteContent    SiteContent?
  products       Product[]
  categories     Category[]
  orders         Order[]
  customers      Customer[]
  transactions   FinancialTransaction[]
  gallery        GalleryImage[]
  testimonials   Testimonial[]
  differentiators Differentiator[]
  auditLogs      AuditLog[]

  @@index([status])
}

model CompanySettings {
  id                String   @id @default(uuid())
  companyId         String   @unique
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description       String   @default("")
  whatsapp          String   @default("")
  instagram         String   @default("")
  phone             String   @default("")
  address           String   @default("")
  businessHours     String   @default("")
  colorBackground   String   @default("#FFF9F5")
  colorPrimary      String   @default("#5A3825")
  colorSecondary    String   @default("#C58B5C")
  colorCream        String   @default("#F5E6D3")
  colorText         String   @default("#241A15")
  bannerUrl         String?
  whatsappMessage   String   @default("Olá! Gostaria de fazer um pedido.")
  updatedAt         DateTime @updatedAt
}

model SiteContent {
  id                    String  @id @default(uuid())
  companyId             String  @unique
  company               Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  heroTitle             String  @default("Um pedacinho de felicidade em cada colherada.")
  heroSubtitle          String  @default("Pudins artesanais preparados com carinho, qualidade e aquele sabor que dá vontade de repetir.")
  aboutTitle            String  @default("Feito com carinho, pensado para você.")
  aboutText             String  @default("Produzimos pudins artesanais com ingredientes selecionados, em receitas pensadas para encantar em cada colherada.")
  productsTitle         String  @default("Nossos Pudins")
  productsSubtitle      String  @default("Sabores clássicos e criações especiais, sempre fresquinhos.")
  differentiatorsTitle  String  @default("Por que escolher nossos pudins?")
  testimonialsTitle     String  @default("Quem prova, recomenda")
  instagramTitle        String  @default("Siga a gente no Instagram")
  galleryTitle          String  @default("Um pouco do nosso universo")
  contactTitle          String  @default("Vamos adoçar o seu dia?")
  updatedAt             DateTime @updatedAt
}

model Differentiator {
  id          String  @id @default(uuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String
  icon        String  @default("Heart")
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  @@index([companyId])
}

model Category {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, slug])
  @@index([companyId])
}

model Product {
  id                String      @id @default(uuid())
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId        String
  category          Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name              String
  description       String
  price             Decimal
  promotionalPrice  Decimal?
  imageUrl          String?
  stock             Int         @default(0)
  isAvailable       Boolean     @default(true)
  isFeatured        Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]

  @@index([companyId])
  @@index([companyId, isAvailable])
  @@index([categoryId])
}

model Customer {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([companyId])
  @@index([companyId, phone])
}

model Order {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  number        Int
  status        OrderStatus   @default(NEW)
  paymentMethod PaymentMethod @default(PIX)
  notes         String?
  subtotal      Decimal
  total         Decimal
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  transactions  FinancialTransaction[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal
  total     Decimal
}

model FinancialTransaction {
  id          String          @id @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        TransactionType
  category    String
  description String
  amount      Decimal
  date        DateTime
  notes       String?
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([companyId])
  @@index([companyId, type, date])
}

model GalleryImage {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Testimonial {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  photoUrl  String?
  text      String
  rating    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  action     String
  details    String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}
