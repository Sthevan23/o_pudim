PORT=3333
NODE_ENV=development

# Desenvolvimento (Windows / sem Docker): SQLite
DATABASE_URL="file:./prisma/dev.db"
USE_EMBEDDED_PG=false

# Produção com PostgreSQL (docker compose):
# 1) no schema.prisma, altere provider para "postgresql"
# 2) DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/o_pudim"
# 3) USE_EMBEDDED_PG=false

JWT_SECRET="troque-esta-chave-em-producao"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"
